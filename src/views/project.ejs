<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2><%= project.title %></h2>
    <p>Description: <%= project.description %></p>
    <% 
        const friendlyDate = new Date(project.date).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        });
    %>
    <p>Date: <%= friendlyDate %></p>
    <p>Location: <%= project.location %></p>
    <p>Organization: <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>

    <strong><p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p></strong>
    <strong><p><a href="/assign-categories/<%= project.project_id %>">Edit Categories</a></p></strong>

    <% if (categories && categories.length > 0) { %>
        <div class="category-tags">
            <% categories.forEach(cat => { %>
                <a href="/category/<%= cat.category_id %>" class="tag"><%= cat.name %></a>
            <% }) %>
        </div>
    <% } %>
</main>
<%- include('partials/footer') %>